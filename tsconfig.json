{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types", "./src/types", "./typings"],
    "sourceMap": true,
    "noImplicitAny": false
  },
  "include": ["src/**/*", "utils/**/*", "typings/**/*"],
  "exclude": ["node_modules", "dist"]
} 